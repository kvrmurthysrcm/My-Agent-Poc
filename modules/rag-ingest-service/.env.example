DATABASE_URL=postgresql://library_user:library_pass@localhost:5432/online_library
STORAGE_ROOT=./storage
DELETE_ORIGINAL_FILE_AFTER_INGESTION=true
MAX_UPLOAD_MB=25
SUPPORTED_EXTENSIONS=.txt,.pdf,.docx,.epub
DEFAULT_CHUNK_SIZE_TOKENS=800
DEFAULT_CHUNK_OVERLAP_TOKENS=120
MINIMUM_CHUNK_TOKENS=80
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=embeddinggemma
EMBEDDING_DIMENSION=768
# Supported local Ollama embedding alternatives:
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMENSION=768
# EMBEDDING_MODEL=mxbai-embed-large
# EMBEDDING_DIMENSION=1024
EMBEDDING_VERSION=v1
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_PROVIDER=ollama
LLM_MODEL=mistral:latest
ASYNC_BACKEND=fastapi_background_tasks
RQ_REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_INGESTION_TOPIC=rag.document.ingest.requested
DB_WORKER_POLL_INTERVAL_SECONDS=5
DB_WORKER_BATCH_SIZE=5

