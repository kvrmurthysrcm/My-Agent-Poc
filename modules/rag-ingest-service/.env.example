DATABASE_URL=postgresql://library_user:library_pass@localhost:5432/online_library
APP_PROFILE=local
ENABLE_DEV_DELETE_ENDPOINT=true
STORAGE_ROOT=./storage
DELETE_ORIGINAL_FILE_AFTER_INGESTION=true
DUPLICATE_DOCUMENT_POLICY=version
PROFILING=true
MAX_UPLOAD_MB=25
SUPPORTED_EXTENSIONS=.txt,.pdf,.docx,.epub
DEFAULT_CHUNK_SIZE_TOKENS=1200
DEFAULT_CHUNK_OVERLAP_TOKENS=80
DEFAULT_CHUNKING_STRATEGY=SEMANTIC_RECURSIVE
MINIMUM_CHUNK_TOKENS=80
PDF_PARSER=pymupdf
# fallback option:
# PDF_PARSER=pypdf
AUTO_CREATE_TABLES=false
AUTO_MIGRATE_ON_STARTUP=true
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=64
EMBEDDING_CONCURRENCY=1
EMBEDDING_MAX_RETRIES=2
EMBEDDING_RETRY_BACKOFF_SECONDS=1.0
EMBEDDING_RETRY_SHRINK_BATCH=true
EMBEDDING_MIN_BATCH_SIZE=1
# Supported local Ollama embedding alternatives:
# EMBEDDING_MODEL=embeddinggemma
# EMBEDDING_DIMENSION=768
# EMBEDDING_MODEL=mxbai-embed-large
# EMBEDDING_DIMENSION=1024
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_DIMENSION=1024
EMBEDDING_VERSION=v1
OPENAI_API_KEY=
ALLOW_FAKE_EMBEDDINGS=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_TIMEOUT_SECONDS=60
LLM_PROVIDER=ollama
LLM_MODEL=mistral:latest
ASYNC_BACKEND=fastapi_background_tasks
RQ_REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_INGESTION_TOPIC=rag.document.ingest.requested
DB_WORKER_POLL_INTERVAL_SECONDS=5
DB_WORKER_BATCH_SIZE=5
RECOVERY_WORKER_POLL_INTERVAL_SECONDS=30
RECOVERY_STALE_AFTER_SECONDS=900
