{
  "info": {
    "name": "Online Library API POC",
    "description": "Postman collection for Online Library catalog search APIs and read-only SELECT APIs over non-empty Online Library tables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8003"
    },
    {
      "key": "resourceId",
      "value": "replace-with-resource-id-from-catalog-list"
    }
  ],
  "item": [
    {
      "name": "Health - DB",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health/db"
      }
    },
    {
      "name": "List Exposed Tables",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/tables"
      }
    },
    {
      "name": "Catalog Search",
      "item": [
        {
          "name": "Catalog - List Resources",
          "request": {
            "method": "GET",
            "description": "List catalog resources with joined authors/tags and binary content excluded.",
            "url": "{{baseUrl}}/catalog/resources?limit=5&offset=0"
          }
        },
        {
          "name": "Catalog - Search by Text",
          "request": {
            "method": "GET",
            "description": "Search title, description, publisher, ISBN, author, tag, and category using q.",
            "url": "{{baseUrl}}/catalog/resources?q=christmas&limit=5&offset=0"
          }
        },
        {
          "name": "Catalog - Search by Author",
          "request": {
            "method": "GET",
            "description": "Search resources by author name.",
            "url": "{{baseUrl}}/catalog/resources?author=Charles%20Dickens&limit=5&offset=0"
          }
        },
        {
          "name": "Catalog - Search by Genre",
          "request": {
            "method": "GET",
            "description": "Search resources by genre. Genre is an alias for category.",
            "url": "{{baseUrl}}/catalog/resources?genre=Drama&limit=5&offset=0"
          }
        },
        {
          "name": "Catalog - Search by Tag",
          "request": {
            "method": "GET",
            "description": "Search resources by tag name.",
            "url": "{{baseUrl}}/catalog/resources?tag=classic&limit=5&offset=0"
          }
        },
        {
          "name": "Catalog - Filter by Tier and Status",
          "request": {
            "method": "GET",
            "description": "Filter resources by subscription tier and resource status.",
            "url": "{{baseUrl}}/catalog/resources?tier=FREE&status=ACTIVE&limit=5&offset=0"
          }
        },
        {
          "name": "Catalog - Published Date Range",
          "request": {
            "method": "GET",
            "description": "Filter resources by published_date range and sort by latest published date.",
            "url": "{{baseUrl}}/catalog/resources?published_from=1800-01-01&published_to=1900-12-31&sort=published_desc&limit=5&offset=0"
          }
        },
        {
          "name": "Catalog - Facets",
          "request": {
            "method": "GET",
            "description": "Return lookup values for catalog filters: categories, genres, authors, tags, languages, and subscription tiers.",
            "url": "{{baseUrl}}/catalog/facets"
          }
        },
        {
          "name": "Catalog - Resource Detail",
          "request": {
            "method": "GET",
            "description": "Replace the resource id with one copied from Catalog - List Resources.",
            "url": "{{baseUrl}}/catalog/resources/{{resourceId}}"
          }
        }
      ]
    },
    {
      "name": "SELECT authors",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/authors?limit=20&offset=0"
      }
    },
    {
      "name": "SELECT categories",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/categories?limit=20&offset=0"
      }
    },
    {
      "name": "SELECT library_users",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/library-users?limit=20&offset=0"
      }
    },
    {
      "name": "SELECT reading_progress",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/reading-progress?limit=20&offset=0"
      }
    },
    {
      "name": "SELECT resource_authors",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/resource-authors?limit=20&offset=0"
      }
    },
    {
      "name": "SELECT resource_tags",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/resource-tags?limit=20&offset=0"
      }
    },
    {
      "name": "SELECT resources",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/resources?limit=20&offset=0"
      }
    },
    {
      "name": "SELECT subscription_rules",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/subscription-rules?limit=20&offset=0"
      }
    },
    {
      "name": "SELECT subscription_tiers",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/subscription-tiers?limit=20&offset=0"
      }
    },
    {
      "name": "SELECT tags",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/tags?limit=20&offset=0"
      }
    },
    {
      "name": "SELECT user_approval_requests",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/user-approval-requests?limit=20&offset=0"
      }
    },
    {
      "name": "SELECT user_bookshelf",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/user-bookshelf?limit=20&offset=0"
      }
    },
    {
      "name": "SELECT user_subscriptions",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/user-subscriptions?limit=20&offset=0"
      }
    }
  ]
}
